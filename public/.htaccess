<IfModule mod_rewrite.c>
    RewriteEngine On
    # Si el archivo o directorio existe físicamente en public/, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # De lo contrario, redirigir todo al index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>